#!/usr/bin/env php
<?php
/**
 * Reset password akun admin pada tabel `admin_users`.
 *
 * Script CLI ini dibuat agar reset password admin tidak perlu query manual
 * ke database.
 *
 * Pemakaian:
 *
 *     php reset-admin-password                      # user 'admin', password ditanya interaktif
 *     php reset-admin-password admin                # user 'admin', password ditanya interaktif
 *     php reset-admin-password admin rahasia123     # non-interaktif (berisiko terlihat di history)
 *     php reset-admin-password --username=admin --password=rahasia123
 *     php reset-admin-password --help
 */

// --------------------------------------------------------------
// Bootstrap: konstanta + path milik framework.
// --------------------------------------------------------------
define('DS', DIRECTORY_SEPARATOR);
define('RAKIT_START', microtime(true));

require __DIR__.'/paths.php';

// --------------------------------------------------------------
// Muat Composer autoload (untuk helper env()) dan file .env.
// Urutan ini sama dengan yang dipakai `index.php`.
// --------------------------------------------------------------
if (is_file($autoload = __DIR__.'/vendor/autoload.php')) {
    require_once $autoload;

    if (class_exists('Dotenv\\Dotenv')) {
        Dotenv\Dotenv::createImmutable(__DIR__)->safeLoad();
    }

    unset($autoload);
}

require path('system').'core.php';

if (! is_cli()) {
    exit('Script ini hanya bisa dijalankan dari command line (CLI).'.PHP_EOL);
}

// --------------------------------------------------------------
// Boot paket default agar konfigurasi database tersedia.
// --------------------------------------------------------------
\System\Package::boot(DEFAULT_PACKAGE);

/**
 * Tampilkan cara pemakaian script.
 *
 * @return void
 */
function reset_admin_password_usage()
{
    echo 'Reset password akun admin (tabel admin_users).'.PHP_EOL;
    echo PHP_EOL;
    echo 'Pemakaian:'.PHP_EOL;
    echo '  php reset-admin-password [username] [password] [--username=] [--password=]'.PHP_EOL;
    echo PHP_EOL;
    echo 'Contoh:'.PHP_EOL;
    echo '  php reset-admin-password'.PHP_EOL;
    echo '  php reset-admin-password admin'.PHP_EOL;
    echo '  php reset-admin-password admin rahasia123'.PHP_EOL;
    echo '  php reset-admin-password --username=admin --password=rahasia123'.PHP_EOL;
    echo PHP_EOL;
    echo 'Catatan:'.PHP_EOL;
    echo '  - Tanpa argumen password, script akan meminta password secara interaktif'.PHP_EOL;
    echo '    dan menyembunyikan ketikan.'.PHP_EOL;
    echo '  - Mengirim password lewat argumen/opsi bisa terekam di history shell.'.PHP_EOL;
}

/**
 * Baca input password tanpa menampilkan ketikan (jika memungkinkan).
 *
 * @param string $label
 *
 * @return string
 */
function reset_admin_password_prompt($label)
{
    fwrite(STDOUT, $label);

    if (DIRECTORY_SEPARATOR === '\\' || ! function_exists('shell_exec')) {
        return rtrim((string) fgets(STDIN), "\r\n");
    }

    $saved = @shell_exec('stty -g 2>/dev/null');

    if (is_string($saved) && trim($saved) !== '') {
        @shell_exec('stty -echo 2>/dev/null');
        $line = fgets(STDIN);
        @shell_exec('stty '.escapeshellarg(trim($saved)).' 2>/dev/null');
        fwrite(STDOUT, PHP_EOL);

        return rtrim((string) $line, "\r\n");
    }

    return rtrim((string) fgets(STDIN), "\r\n");
}

// --------------------------------------------------------------
// Parse argumen dan opsi.
// --------------------------------------------------------------
$arguments = array_slice($argv, 1);
$positional = [];
$options = [];

foreach ($arguments as $argument) {
    if (preg_match('/^--([^=]+)=(.*)$/s', $argument, $matches)) {
        $options[strtolower($matches[1])] = $matches[2];
    } elseif (strpos($argument, '--') === 0) {
        $options[strtolower(substr($argument, 2))] = true;
    } elseif (strpos($argument, '-') === 0) {
        $options[strtolower(substr($argument, 1))] = true;
    } else {
        $positional[] = $argument;
    }
}

if (isset($options['help']) || isset($options['h'])) {
    reset_admin_password_usage();
    exit(0);
}

$username = isset($options['username']) ? (string) $options['username'] : (isset($positional[0]) ? $positional[0] : 'admin');
$password = isset($options['password']) ? (string) $options['password'] : (isset($positional[1]) ? $positional[1] : null);

if (trim($username) === '') {
    fwrite(STDERR, 'Username tidak boleh kosong.'.PHP_EOL);
    exit(1);
}

if ($password === null) {
    $password = reset_admin_password_prompt('Password baru untuk "'.$username.'": ');
    $confirm = reset_admin_password_prompt('Ulangi password baru: ');

    if ($password !== $confirm) {
        fwrite(STDERR, 'Password dan konfirmasi tidak sama. Dibatalkan.'.PHP_EOL);
        exit(1);
    }
}

if ($password === '') {
    fwrite(STDERR, 'Password tidak boleh kosong. Dibatalkan.'.PHP_EOL);
    exit(1);
}

// --------------------------------------------------------------
// Update password di database.
// --------------------------------------------------------------
try {
    $connection = \System\Database::connection();
    $database = (string) env('DB_DATABASE', 'unknown');

    $user = $connection->first('SELECT id, username, is_active FROM admin_users WHERE username = ? LIMIT 1', [$username]);

    if (! $user) {
        fwrite(STDERR, 'User "'.$username.'" tidak ditemukan di tabel admin_users.'.PHP_EOL);

        $rows = $connection->query('SELECT username FROM admin_users ORDER BY id ASC');

        if (count($rows) > 0) {
            $names = [];

            foreach ($rows as $row) {
                $names[] = $row->username;
            }

            fwrite(STDERR, 'Username yang tersedia: '.implode(', ', $names).PHP_EOL);
        } else {
            fwrite(STDERR, 'Tabel admin_users masih kosong.'.PHP_EOL);
        }

        exit(1);
    }

    $hash = password_hash($password, PASSWORD_DEFAULT);
    $connection->query('UPDATE admin_users SET password_hash = ?, updated_at = ? WHERE id = ?', [
        $hash,
        date('Y-m-d H:i:s'),
        (int) $user->id,
    ]);

    // Pastikan hash yang tersimpan benar - benar cocok dengan password baru.
    $check = $connection->first('SELECT password_hash FROM admin_users WHERE id = ? LIMIT 1', [(int) $user->id]);

    if (! $check || ! password_verify($password, $check->password_hash)) {
        fwrite(STDERR, 'Password tersimpan, tetapi gagal diverifikasi. Periksa kembali database.'.PHP_EOL);
        exit(1);
    }

    echo 'Password berhasil direset.'.PHP_EOL;
    echo '  Database : '.$database.PHP_EOL;
    echo '  Username : '.$user->username.PHP_EOL;
    echo '  Aktif    : '.((int) $user->is_active === 1 ? 'ya' : 'TIDAK (login akan ditolak, set is_active = 1)').PHP_EOL;

    if (strlen($password) < 8) {
        echo PHP_EOL;
        echo 'Catatan: password kurang dari 8 karakter. Login tetap bisa, tetapi form'.PHP_EOL;
        echo 'di /admin/account hanya menerima password minimal 8 karakter.'.PHP_EOL;
    }
} catch (\Throwable $e) {
    fwrite(STDERR, 'Gagal reset password: '.$e->getMessage().PHP_EOL);
    exit(1);
} catch (\Exception $e) {
    fwrite(STDERR, 'Gagal reset password: '.$e->getMessage().PHP_EOL);
    exit(1);
}
